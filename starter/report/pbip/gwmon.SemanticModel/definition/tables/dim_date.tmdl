table dim_date

	column Date
		dataType: dateTime
		dataCategory: PaddedDateTableDates
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName

	column MonthNumber
		dataType: int64
		summarizeBy: none
		sourceColumn: MonthNumber

	partition dim_date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: dbo
			expressionSource: DirectLakeSource

