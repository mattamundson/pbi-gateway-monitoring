table gold_query_performance

	column QueryType
		dataType: string
		summarizeBy: none
		sourceColumn: QueryType

	column DataSource
		dataType: string
		summarizeBy: none
		sourceColumn: DataSource

	column query_count
		dataType: int64
		summarizeBy: none
		sourceColumn: query_count

	column error_count
		dataType: int64
		summarizeBy: none
		sourceColumn: error_count

	column duration_ms_avg
		dataType: double
		summarizeBy: none
		sourceColumn: duration_ms_avg

	column duration_ms_p95
		dataType: double
		summarizeBy: none
		sourceColumn: duration_ms_p95

	column duration_ms_max
		dataType: double
		summarizeBy: none
		sourceColumn: duration_ms_max

	column spool_total_bytes_sum
		dataType: double
		summarizeBy: none
		sourceColumn: spool_total_bytes_sum

	column spool_writing_ms_avg
		dataType: double
		summarizeBy: none
		sourceColumn: spool_writing_ms_avg

	column spooled_query_count
		dataType: int64
		summarizeBy: none
		sourceColumn: spooled_query_count

	column hour_utc
		dataType: dateTime
		summarizeBy: none
		sourceColumn: hour_utc

	column _partition_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: _partition_date

	partition gold_query_performance = entity
		mode: directLake
		source
			entityName: gold_query_performance
			schemaName: dbo
			expressionSource: DirectLakeSource

