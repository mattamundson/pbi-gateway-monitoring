table silver_identity_attribution

	column attribution_kind
		dataType: string
		summarizeBy: none
		sourceColumn: attribution_kind

	column artifact_id
		dataType: string
		summarizeBy: none
		sourceColumn: artifact_id

	column DataSource
		dataType: string
		summarizeBy: none
		sourceColumn: DataSource

	column attribution_confidence
		dataType: string
		summarizeBy: none
