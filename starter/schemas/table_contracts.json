        "error_count_5min": "long",
        "duration_avg_ms": "double",
        "duration_p95_ms": "double",
        "error_rate_pct": {
          "type": "double",
          "scale": "percent-0-100",
          "note": "PERCENT, not fraction. A rule written against a 0-1 fraction fires on virtually every window."
        },
        "cpu_pct_avg": "double",
        "mem_kb_avg": "double",
        "system_cpu_avg": "double",
        "last_counter_utc": "timestamp",
        "spool_free_pct": "double",
        "spool_dir_size_bytes": "long",
        "spool_alert_level": "string",
        "spool_stream_mode_warn": "boolean",
        "nic_bytes_per_sec_avg": "double",
        "latency_ms_avg": "double",
        "latency_ms_p95": "double",
        "network_utilization_pct_avg": "double",
        "_computed_at_utc": "timestamp",
        "_partition_date": "date"
      }
    },
    "gold_query_performance": {
