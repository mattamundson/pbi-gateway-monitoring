# --- Secrets / gateway config (NEVER commit) ---
# The FPM gateway config carries SP AppId + a machine-bound encrypted SecretText
# and EventHub connection strings. Keep all real configs out of git.
config.json
Config.json
**/configs/
**/configs/*.json
*.secret
*.secrets
.env
.env.*
*.pfx
*.pem
*.key

# --- PowerShell / script runtime artifacts ---
logs/
**/logs/
*.log
Temp/
**/Temp/
fpm-tasks/
*.final.xml

# --- Health/validation outputs ---
health.json
*-health.json
fpm-health*.csv

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# --- Build / packaging ---
*.zip
*.tar.gz

# --- AI-assistant session artifacts / local tool config (NEVER commit) ---
# These leak account PII, org identity, and the paths of unrelated local projects.
.claude.json
.claude/
.cursor/
conversation/raw_session_context/

# --- Office binary exports (markdown is the source of truth; do not commit .docx) ---
*.docx

# --- Browser/OS "copy" duplicates, e.g. "runbook (1).md" ---
* (1).*
* (2).*
* (3).*
* (4).*

# --- Python test artifacts ---
__pycache__/
*.pyc
.pytest_cache/
starter/tests/synthetic_out/
